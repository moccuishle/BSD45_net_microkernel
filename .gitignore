# ---- build products (regenerated by the build scripts) ----
**/bsd45/build/
**/bsd45/out/
**/bsd45/BSD45.ELF
*.o
*.pe
*.elf

# ---- large local artifacts, not part of the source tree ----
4.5BSD-jialiang.tar.gz
4.5BSD-Lite2.tar.gz
4.4BSD-Lite2.tar.gz
*.iso
*.img
tools/putty/

# ---- local reference trees / archives ----
reno/
reno-src-main.zip
_reno/

# ---- scratch / logs ----
*.ppm
*.log
*.tmp
.tmp/
build/*.txt

# ---- editor / OS junk ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/
__pycache__/
*.pyc

# ---- VMware runtime files ----
**/bsd45/vms/*.scoreboard
**/bsd45/vms/*.vmsd
**/bsd45/vms/*.vmxf
**/bsd45/vms/nvram
**/bsd45/vms/*.lck/
**/bsd45/vms/*.log
**/bsd45/vms/*.vmem
**/bsd45/vms/*.vmsn
**/bsd45/vms/*.vmss

# ---- VMware virtual disks (generated/installed artifacts) ----
*.vmdk

# ---- BSD yacc/flex host tools (rebuilt by bsd45/tools/build_bsdtools.ps1) ----
bsd45/tools/bsdsrc/
bsd45/tools/hostbin/
